{% extends "../../layouts/master.njk" %}

{% block csslib %}
	<link href="/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block jslib %}
	{# //- // begin::Vendors Javascript(used by this page) #}
	<script src='/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.js'></script>
	{# //- // end::Vendors Javascript #}
	{# //- // begin::Custom Javascript(used by this page) #}
	<script src='/cms-static/admin/assets/js/widgets.bundle.js'></script>
	<script src='/cms-static/admin/assets/js/custom/widgets.js'></script>
	<script src='https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.21/lodash.min.js'></script>
	<script src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js'></script>
	{# //- // end::Custom Javascript #}

	<script src='/cms-static/common/js/form-data-json.min.js'></script>
	<script src='/cms-static/common/js/es-form.js'></script>
	<script src='/cms-static/common/js/field-generator.js'></script>
{% endblock %}

{% block customScript %}
	<script>
		fieldSchemaJson = {{fields_to_map | safe}} || [];
		bkupDataJson = _.cloneDeep(fieldSchemaJson)
		generateField()
	</script>
{% endblock %}

{% block content %}
	{% block title %}
		<title>{{ contentType.title }} Configuration - {{browserTitle | upper()}} CMS</title>
	{% endblock %}

	<div class="d-flex flex-column flex-column-fluid">
		<div class="app-toolbar py-3 py-lg-6" id="beaver_app_toolbar">
			<div class="app-container container-xxl d-flex flex-stack" id="beaver_app_toolbar_container">
				<div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
					<h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">Content Type Details | {{contentType.title}}</h1>
					<ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
						<li class="breadcrumb-item text-muted">
							<a class="text-muted text-hover-primary" href="{{LANDING_URL}}">Dashboard</a>
						</li>
						<li class="breadcrumb-item">
							<span class="bullet bg-gray-400 w-5px h-2px"></span></li>
						<li class="breadcrumb-item text-muted">Content Type <span class="bullet bg-gray-400 w-5px h-2px ms-1"></span></li>
						<li class="breadcrumb-item text-muted">View</li>
					</ul>
				</div>
				<div class="d-flex align-items-center gap-2 gap-lg-3">
					<a href="/admin/config/content-type/" class="btn btn-sm fw-bold btn-light">
						<i class="fa fa-arrow-left"></i>
						Back
					</a>
					<a href="{{ '/admin/config/content-type/edit/' + contentType._id }}" class="btn btn-sm fw-bold btn-light-primary">Edit Content Type</a>
				</div>
			</div>
		</div>

		<div class="app-content flex-column-fluid" id="beaver_app_content">
			<div class="app-container container-xxl" id="beaver_app_content_container">
				<div class="row">
					<div class="col-3">
						<ul class="nav nav-tabs nav-pills flex-row border-0 flex-md-column me-5 mb-3 mb-md-0 fs-6 min-w-lg-200px">

							<li class="nav-item w-100 me-0 mb-md-2">
								<a class="nav-link active w-100 btn btn-flex btn-active-light-info" data-bs-toggle="tab" href="#beaver_vtab_pane_5">
									<span class="svg-icon svg-icon-2">
										<svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path opacity="0.3" d="M22.1 11.5V12.6C22.1 13.2 21.7 13.6 21.2 13.7L19.9 13.9C19.7 14.7 19.4 15.5 18.9 16.2L19.7 17.2999C20 17.6999 20 18.3999 19.6 18.7999L18.8 19.6C18.4 20 17.8 20 17.3 19.7L16.2 18.9C15.5 19.3 14.7 19.7 13.9 19.9L13.7 21.2C13.6 21.7 13.1 22.1 12.6 22.1H11.5C10.9 22.1 10.5 21.7 10.4 21.2L10.2 19.9C9.4 19.7 8.6 19.4 7.9 18.9L6.8 19.7C6.4 20 5.7 20 5.3 19.6L4.5 18.7999C4.1 18.3999 4.1 17.7999 4.4 17.2999L5.2 16.2C4.8 15.5 4.4 14.7 4.2 13.9L2.9 13.7C2.4 13.6 2 13.1 2 12.6V11.5C2 10.9 2.4 10.5 2.9 10.4L4.2 10.2C4.4 9.39995 4.7 8.60002 5.2 7.90002L4.4 6.79993C4.1 6.39993 4.1 5.69993 4.5 5.29993L5.3 4.5C5.7 4.1 6.3 4.10002 6.8 4.40002L7.9 5.19995C8.6 4.79995 9.4 4.39995 10.2 4.19995L10.4 2.90002C10.5 2.40002 11 2 11.5 2H12.6C13.2 2 13.6 2.40002 13.7 2.90002L13.9 4.19995C14.7 4.39995 15.5 4.69995 16.2 5.19995L17.3 4.40002C17.7 4.10002 18.4 4.1 18.8 4.5L19.6 5.29993C20 5.69993 20 6.29993 19.7 6.79993L18.9 7.90002C19.3 8.60002 19.7 9.39995 19.9 10.2L21.2 10.4C21.7 10.5 22.1 11 22.1 11.5ZM12.1 8.59998C10.2 8.59998 8.6 10.2 8.6 12.1C8.6 14 10.2 15.6 12.1 15.6C14 15.6 15.6 14 15.6 12.1C15.6 10.2 14 8.59998 12.1 8.59998Z" fill="currentColor"></path>
											<path d="M17.1 12.1C17.1 14.9 14.9 17.1 12.1 17.1C9.30001 17.1 7.10001 14.9 7.10001 12.1C7.10001 9.29998 9.30001 7.09998 12.1 7.09998C14.9 7.09998 17.1 9.29998 17.1 12.1ZM12.1 10.1C11 10.1 10.1 11 10.1 12.1C10.1 13.2 11 14.1 12.1 14.1C13.2 14.1 14.1 13.2 14.1 12.1C14.1 11 13.2 10.1 12.1 10.1Z" fill="currentColor"></path>
										</svg>
									</span>
									<span class="d-flex flex-column align-items-start">
										<span class="fs-4 fw-bold">Config</span>
										<span class="fs-7">General Configuration</span>
									</span>
								</a>
							</li>

							{% if contentType.page_builder == false %}
								<li class="nav-item w-100 me-0 mb-md-2">
									<a class="nav-link w-100 btn btn-flex btn-active-light-success" data-bs-toggle="tab" href="#beaver_vtab_pane_4">
										<span class="svg-icon svg-icon-2">
											<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
												<rect opacity="0.3" x="2" y="2" width="20" height="20" rx="5" fill="currentColor"/>
												<path d="M11.9343 12.5657L9.53696 14.963C9.22669 15.2733 9.18488 15.7619 9.43792 16.1204C9.7616 16.5789 10.4211 16.6334 10.8156 16.2342L14.3054 12.7029C14.6903 12.3134 14.6903 11.6866 14.3054 11.2971L10.8156 7.76582C10.4211 7.3666 9.7616 7.42107 9.43792 7.87962C9.18488 8.23809 9.22669 8.72669 9.53696 9.03696L11.9343 11.4343C12.2467 11.7467 12.2467 12.2533 11.9343 12.5657Z" fill="currentColor"/>
											</svg>
										</span>
										<span class="d-flex flex-column align-items-start">
											<span class="fs-4 fw-bold">Fields</span>
											<span class="fs-7">Field Configuration</span>
										</span>
									</a>
								</li>
							{% endif %}

							{% if contentType.has_meta %}

								<li class="nav-item w-100 me-0 mb-md-2">
									<a class="nav-link w-100 btn btn-flex btn-active-light-info" data-bs-toggle="tab" href="#beaver_vtab_pane_6">
										<span class="svg-icon svg-icon-2">
											<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
												<path opacity="0.3" d="M19.0687 17.9688H11.0687C10.4687 17.9688 10.0687 18.3687 10.0687 18.9688V19.9688C10.0687 20.5687 10.4687 20.9688 11.0687 20.9688H19.0687C19.6687 20.9688 20.0687 20.5687 20.0687 19.9688V18.9688C20.0687 18.3687 19.6687 17.9688 19.0687 17.9688Z" fill="currentColor"/>
												<path d="M4.06875 17.9688C3.86875 17.9688 3.66874 17.8688 3.46874 17.7688C2.96874 17.4688 2.86875 16.8688 3.16875 16.3688L6.76874 10.9688L3.16875 5.56876C2.86875 5.06876 2.96874 4.46873 3.46874 4.16873C3.96874 3.86873 4.56875 3.96878 4.86875 4.46878L8.86875 10.4688C9.06875 10.7688 9.06875 11.2688 8.86875 11.5688L4.86875 17.5688C4.66875 17.7688 4.36875 17.9688 4.06875 17.9688Z" fill="currentColor"/>
											</svg>
										</span>
										<span class="d-flex flex-column align-items-start">
											<span class="fs-4 fw-bold">Meta</span>
											<span class="fs-7">Meta for Collection API</span>
										</span>
									</a>
								</li>

							{% endif %}

							<li class="nav-item w-100 me-0 mb-md-2">
								<a class="nav-link w-100 btn btn-flex btn-active-light-warning" data-bs-toggle="tab" href="#beaver_vtab_pane_revisions">
									<span class="svg-icon svg-icon-2">
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path opacity="0.3" d="M20.9 12.9C20.3 12.9 19.9 12.5 19.9 11.9C19.9 11.3 20.3 10.9 20.9 10.9H21.8C21.3 6.2 17.6 2.4 12.9 2V2.9C12.9 3.5 12.5 3.9 11.9 3.9C11.3 3.9 10.9 3.5 10.9 2.9V2C6.2 2.5 2.4 6.2 2 10.9H2.9C3.5 10.9 3.9 11.3 3.9 11.9C3.9 12.5 3.5 12.9 2.9 12.9H2C2.5 17.6 6.2 21.4 10.9 21.8V20.9C10.9 20.3 11.3 19.9 11.9 19.9C12.5 19.9 12.9 20.3 12.9 20.9V21.8C17.6 21.3 21.4 17.6 21.8 12.9H20.9Z" fill="currentColor"/>
											<path d="M16.9 10.9H13.6C13.4 10.6 13.2 10.4 12.9 10.2V5.90002C12.9 5.30002 12.5 4.90002 11.9 4.90002C11.3 4.90002 10.9 5.30002 10.9 5.90002V10.2C10.3 10.6 9.90002 11.2 9.90002 11.9C9.90002 13 10.8 13.9 11.9 13.9C12.6 13.9 13.2 13.5 13.6 12.9H16.9C17.5 12.9 17.9 12.5 17.9 11.9C17.9 11.3 17.5 10.9 16.9 10.9Z" fill="currentColor"/>
										</svg>
									</span>
									<span class="d-flex flex-column align-items-start">
										<span class="fs-4 fw-bold">Revisions</span>
										<span class="fs-7">{{ contentType.revisions.length if contentType.revisions else 0 }} saved · change history</span>
									</span>
								</a>
							</li>

						</ul>
					</div>

					<div class="col-9">
						<div class="tab-content" id="myTabContent">

							{% if contentType.page_builder == false %}
								<div id="beaver_vtab_pane_4" class="tab-pane fade" role="tabpanel">
									<div class="card mb-5 mb-xl-10">
										<div class="card-header border-0 cursor-pointer" role="button" data-bs-toggle="collapse" data-bs-target="#beaver_account_profile_details" aria-expanded="true" aria-controls="beaver_account_profile_details">
											<div class="card-title m-0">
												<h3 class="fw-bold m-0">Content Fields</h3>
											</div>
											<div class="card-toolbar">
												<a class="btn btn-sm fw-bold btn-light-primary me-2" data-bs-toggle="modal" data-bs-target="#field_section_form_modal">
													<i class="fa fa-plus"></i>
													Add Field Section
												</a>
												<button class="btn btn-sm btn-dark" type="button" disabled="true" id="schema-save-btn">
													<i class="las la-save"></i> Save
  												</button>
											</div>
										</div>
										<input type="hidden" name="id" value="{{ contentType._id }}">
										<div class="card-body border-top p-9">
											<div class="form-field-holder"></div>
										</div>
									</div>
								</div>
							{% endif %}

							<div class="tab-pane fade show active" id="beaver_vtab_pane_5" role="tabpanel">
								<div class="card mb-5 mb-xl-10">
									<div class="card-header border-0 cursor-pointer" role="button" data-bs-toggle="collapse" data-bs-target="#beaver_account_profile_details" aria-expanded="true" aria-controls="beaver_account_profile_details">
										<div class="card-title m-0">
											<h3 class="fw-bold m-0">Content Type</h3>
										</div>
									</div>
									<div id="beaver_account_settings_profile_details">
										<div class="card-body border-top p-9">
											<div class="row mb-6">
												<label class="col-lg-4 col-form-label required fw-semibold fs-6">Brand</label>
												<div class="col-lg-8 pt-2">
													{% for brand in contentType.brand %}
														<span class="badge badge-dark">{{ brand.name.en }}</span>
													{% endfor %}
												</div>
											</div>
											<div class="row mb-6">
												<label class="col-lg-4 col-form-label required fw-semibold fs-6">Title</label>
												<div class="col-lg-8 pt-2">{{ contentType.title }}</div>
											</div>
											<div class="row mb-6">
												<label class="col-lg-4 col-form-label required fw-semibold fs-6">URL</label>
												<div class="col-lg-8 pt-2">{{ contentType.slug }}</div>
											</div>
											<div class="row mb-6">
												<label class="col-lg-4 col-form-label required fw-semibold fs-6">Type</label>
												<div class="col-lg-8 pt-2">{{ 'Single' if contentType.single_type == true else 'Collection' }}</div>
											</div>
											<div class="row mb-6">
												<label class="col-lg-4 col-form-label required fw-semibold fs-6">Editor Type</label>
												<div class="col-lg-8 pt-2">{{ 'Page Builder' if contentType.page_builder == true else 'Default' }}</div>
											</div>
											<div class="row mb-6">
												<label class="col-lg-4 col-form-label required fw-semibold fs-6">Position</label>
												<div class="col-lg-8 pt-2">{{ contentType.position }}</div>
											</div>
											<div class="row mb-6">
												<label class="col-lg-4 col-form-label required fw-semibold fs-6">Admin Icon (SVG Code)</label>
												<div class="col-lg-8 pt-2">
													<span class="svg-icon svg-icon-muted svg-icon-2hx">{{ contentType.admin_icon | safe }}</span>
												</div>
											</div>
											<div class="row mb-6">
												<label class="col-lg-4 col-form-label required fw-semibold fs-6">Attachable type</label>
												<div class="col-lg-8 pt-2">
													{% if contentType.allowed_type %}
														{% for ct in contentType.allowed_type %}
															<span class="badge badge-dark mr-1">{{ ct }}</span>
														{% endfor %}
													{% endif %}
												</div>
											</div>
										</div>
									</div>
								</div>

								{# //- include field-config-form	 #}

								<div class="card mb-5 mb-xl-10">
									<div class="card-header border-0 cursor-pointer" role="button" data-bs-toggle="collapse" data-bs-target="#beaver_account_profile_details" aria-expanded="true" aria-controls="beaver_account_profile_details">
										<div class="card-title m-0">
											<h3 class="fw-bold m-0">Features</h3>
										</div>
									</div>
									<div id="beaver_account_settings_profile_details">
										<div class="card-body border-top p-9">
											<div class="row mb-6">
												<div class="row mt-3">
													<div class="form-check form-check-custom form-check-solid form-check-sm col-md-6 mt-4">
														<input id="has_slug" class="form-check-input" type="checkbox" value="true" disabled="true" name="has_slug" {{ 'checked' if contentType.has_slug }}>
														<label class="form-check-label" for="has_slug">Has Slug (URL)</label>
													</div>
													<div class="form-check form-check-custom form-check-solid form-check-sm col-md-6 mt-4">
														<input id="active" class="form-check-input" type="checkbox" value="true" disabled="true" name="active" {{ 'checked' if contentType.active }}>
														<label class="form-check-label" for="active">Active</label>
													</div>
													<div class="form-check form-check-custom form-check-solid form-check-sm col-md-6 mt-4">
														<input id="has_banner" class="form-check-input" type="checkbox" value="true" disabled="true" name="nav_on_collection_api" {{ 'checked' if contentType.nav_on_collection_api }}>
														<label class="form-check-label" for="nav_on_collection_api">Navigation On Collection API</label>
													</div>
													<div class="form-check form-check-custom form-check-solid form-check-sm col-md-6 mt-4">
														<input id="has_gallery" class="form-check-input" type="checkbox" value="true" disabled="true" name="nav_on_single_api" {{ 'checked' if contentType.nav_on_single_api }}>
														<label class="form-check-label" for="nav_on_single_api">Navigation on Detail API</label>
													</div>
													<div class="form-check form-check-custom form-check-solid form-check-sm col-md-6 mt-4">
														<input id="has_form" class="form-check-input" type="checkbox" value="true" disabled="true" name="has_form" {{ 'checked' if contentType.has_form }}>
														<label class="form-check-label" for="has_form">Has Form</label>
													</div>
													<div class="form-check form-check-custom form-check-solid form-check-sm col-md-6 mt-4">
														<input type="checkbox" value="true" disabled="true" name="has_api_endpoint" id="has_api_endpoint" {{ 'checked' if contentType.has_api_endpoint }} class="form-check-input">
														<label class="form-check-label" for="has_api_endpoint">Has API Endpoint</label>
													</div>
													<div class="form-check form-check-custom form-check-solid form-check-sm col-md-6 mt-4">
														<input type="checkbox" value="true" disabled="true" name="has_meta" id="hide_meta" {{ 'checked' if contentType.has_meta }} class="form-check-input">
														<label class="form-check-label" for="hide_meta">Has Meta</label>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							{% if contentType.has_meta %}
								<div id="beaver_vtab_pane_6" class="tab-pane fade" role="tabpanel">
									<form id="content_type_meta_form" class="form es-form" action="/admin/config/content-type/save-meta" data-disable-reset="true" method="post" autocomplete="off">
										<input type="hidden" name="_id" value={{ contentType._id }}>
										<div class="badge badge-danger fv-plugins-message-container invalid-feedback" id="field-error-_id"></div>
										<div class="card mb-5 mb-xl-10">
											<div class="card-header border-0 cursor-pointer" role="button" data-bs-toggle="collapse" data-bs-target="#beaver_account_profile_details" aria-expanded="true" aria-controls="beaver_account_profile_details">
												<div class="card-title m-0">
													<h3 class="fw-bold m-0">Meta Fields</h3>
												</div>
												<div class="card-toolbar">
													<button class="btn btn-dark btn-sm form-submit-btn" id="beaver_account_profile_details_submit" type="submit">
														<span class="preloader d-none">Saving...</span>
														<span class="label">Save</span>
													</button>
												</div>
											</div>
											<div id="beaver_account_settings_profile_details">
												<div class="card-body border-top p-9">

													<ul class="nav nav-tabs nav-line-tabs mb-5 fs-6">
														{% for brandLanguage in authUser.brand.languages %}
															<li class="nav-item">
																<a class="nav-link {{'active' if loop.index == 1 }}" data-bs-toggle="tab" href="#meta_tab_{{ brandLanguage.prefix }}">{{ brandLanguage.name }}</a>
															</li>
														{% endfor %}
													</ul>

													<div class="tab-content" id="meta-lang-tabs">
														{% for brandLanguage in authUser.brand.languages %}
															<div class="tab-pane fade {{'show active' if loop.index == 1 }}" id="meta_tab_{{ brandLanguage.prefix }}" role="tabpanel">
																{% for meta_section in metaFields %}
																	<h3 class="badge badge-light-success">{{ meta_section.name }}</h3>
																	{% for meta_field in meta_section.fields %}
																		<div class="row mb-6">
																			<label class="col-lg-4 col-form-label fw-semibold fs-6">{{ meta_field.label }}</label>
																			<div class="col-lg-8 pt-2">
																				{% if contentType
																					.meta and contentType
																					.meta[brandLanguage.prefix][meta_section.slug] and contentType
																					.meta[brandLanguage.prefix][meta_section.slug][meta_field.name] %}
																					{% set fieldValue = contentType.meta[brandLanguage.prefix][meta_section.slug][meta_field.name] %}
																				{% else %}
																					{% set fieldValue = '' %}
																				{% endif %}
																				{% if meta_field.type == 'textarea' %}
																					<textarea class="form-control" name="meta[{{brandLanguage.prefix}}][{{ meta_section.slug }}][{{ meta_field.name }}]" placeholder="{{ meta_field.label }}">{{ fieldValue }}</textarea>
																				{% else %}
																					<input type="text" class="form-control" placeholder="{{ meta_field.label }}" name="meta[{{brandLanguage.prefix}}][{{ meta_section.slug }}][{{ meta_field.name }}]" value="{{ fieldValue }}">
																				{% endif %}
																			</div>
																		</div>
																	{% endfor %}
																{% endfor %}
															</div>
														{% endfor %}
													</div>

												</div>
											</div>
										</div>
									</form>
								</div>
							{% endif %}

							<div id="beaver_vtab_pane_revisions" class="tab-pane fade" role="tabpanel">
								<div class="card mb-5 mb-xl-10">
									<div class="card-header border-0">
										<div class="card-title m-0"><h3 class="fw-bold m-0">Revisions</h3></div>
										<div class="card-toolbar">
											<a href="/admin/logs/audit?entity_id={{ contentType._id }}" class="btn btn-sm btn-light-primary">Full audit history</a>
										</div>
									</div>
									<div class="card-body border-top p-9">
										<p class="text-muted fs-7">Each revision is a snapshot of the content type as it was <strong>before</strong> that save. The last {{ contentType.revisions.length if contentType.revisions else 0 }} are kept here; every change is also in the audit log.</p>
										{% if contentType.revisions and contentType.revisions.length %}
											<div class="table-responsive">
												<table class="table table-row-dashed fs-7 align-middle">
													<thead><tr class="text-muted fw-bold text-uppercase fs-8"><th>Revision</th><th>Saved by</th><th>Saved at</th><th class="text-end"></th></tr></thead>
													<tbody>
														{% for rev in contentType.revisions | reverse %}
															<tr>
																<td><span class="badge badge-light-warning">{{ rev.revision_number }}</span></td>
																<td>{{ rev.editor_name or rev.editor or '—' }}</td>
																<td>{% if rev.created_at %}{{ convertDateCustom(rev.created_at, 'dd-MM-yyyy HH:mm') }}{% else %}<span class="text-muted">—</span>{% endif %}</td>
																<td class="text-end">
																	<button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#ct_rev_{{ loop.index }}">View snapshot</button>
																</td>
															</tr>
															<tr class="collapse" id="ct_rev_{{ loop.index }}">
																<td colspan="4"><pre class="fs-8 mh-400px overflow-auto bg-light p-4 mb-0">{{ rev.content | dump(2) }}</pre></td>
															</tr>
														{% endfor %}
													</tbody>
												</table>
											</div>
										{% else %}
											<p class="text-muted mb-0">No revisions yet. One is saved the next time this content type is changed.</p>
										{% endif %}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

