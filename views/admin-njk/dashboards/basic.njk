{% extends "../layouts/master.njk" %}

{% block pageSpecificStyle %}
  <style>
    .dash-stat { border: 0; box-shadow: 0 1px 3px rgba(15, 23, 42, .08); height: 100%; }
    .dash-stat .dash-stat-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .dash-card { border: 0; box-shadow: 0 1px 3px rgba(15, 23, 42, .08); }
    .row > [class*="col"] > .dash-card { height: 100%; }
    .dash-card .card-header { min-height: 56px; }
    .dash-list-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px dashed #e4e6ef; }
    .dash-list-row:last-child { border-bottom: 0; }
    .dash-bar-track { background: #f1f1f4; border-radius: 4px; height: 6px; overflow: hidden; }
    .dash-bar-fill { background: #3e97ff; height: 100%; border-radius: 4px; }
    .dash-trend { display: flex; align-items: flex-end; gap: 4px; height: 70px; }
    .dash-trend-bar { flex: 1; background: #3e97ff; opacity: .85; border-radius: 3px 3px 0 0; min-height: 2px; }
    .dash-thumb { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; background: #f1f1f4; }
    .dash-quick { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid #e4e6ef; border-radius: 10px; color: #3f4254; text-decoration: none; transition: background .15s, border-color .15s; }
    .dash-quick:hover { background: #f5f8ff; border-color: #3e97ff; color: #3e97ff; }
  </style>
{% endblock %}

{% block content %}
  {% block title %}
    <title>Dashboard | {{browserTitle | upper()}} CMS</title>
  {% endblock %}

  {% set content = widgets.content %}
  {% set forms = widgets.forms %}
  {% set media = widgets.media %}
  {% set activity = widgets.activity %}
  {% set accounts = widgets.accounts %}
  {% set siteStatus = widgets.siteStatus %}

  {% macro statusBadge(status) %}
    {% if status == 'published' %}<span class="badge badge-light-success">Published</span>
    {% elif status == 'scheduled' %}<span class="badge badge-light-warning">Scheduled</span>
    {% else %}<span class="badge badge-light">Unpublished</span>{% endif %}
  {% endmacro %}

  {% macro widgetError() %}
    <div class="text-muted fs-7 py-4">This section couldn't be loaded. Try refreshing the page.</div>
  {% endmacro %}

  {% macro contentRows(items, emptyText, showDate) %}
    {% for item in items %}
      <div class="dash-list-row">
        <div class="min-w-0">
          <a href="{{ item.url }}" class="text-gray-800 text-hover-primary fw-semibold d-block text-truncate">{{ item.slug }}</a>
          <span class="text-muted fs-7">{{ item.type }}{% if showDate and item.startsOn %} · {{ item.startsOn }}{% elif item.updatedAgo %} · {{ item.updatedAgo }}{% endif %}{% if item.editor and not showDate %} · {{ item.editor }}{% endif %}</span>
        </div>
        {{ statusBadge(item.status) }}
      </div>
    {% else %}
      <div class="text-muted fs-7 py-4">{{ emptyText }}</div>
    {% endfor %}
  {% endmacro %}

  <div class="d-flex flex-column flex-column-fluid">
    <div class="app-toolbar py-3 py-lg-6" id="beaver_app_toolbar">
      <div class="app-container container-xxl d-flex flex-stack" id="beaver_app_toolbar_container">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
          <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">Dashboard
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
              <li class="breadcrumb-item text-muted">
                <a class="text-muted text-hover-primary" href="{{LANDING_URL}}">Home</a>
              </li>
              <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
              <li class="breadcrumb-item text-muted">Dashboard</li>
            </ul>
          </h1>
        </div>
      </div>
    </div>

    <div class="app-content flex-column-fluid" id="beaver_app_content">
      <div class="app-container container-xxl" id="beaver_app_content_container">

        {# Welcome #}
        <div class="card dash-card mb-6">
          <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-4 py-6">
            <div>
              <h2 class="fw-bold fs-2 mb-1">Welcome back, {{ authUser.admin_name }} 👋</h2>
              <div class="text-muted">
                <span class="badge badge-light-success me-2">{{ authUser.admin_role | replace('_', ' ') | capitalize }}</span>
                {% if authUser.brand and authUser.brand.name %}
                  {{ authUser.brand.name.en }}{% if authUser.brand.country_name %} · {{ authUser.brand.country_name }}{% endif %}
                {% endif %}
              </div>
            </div>
            {% if siteStatus and not siteStatus.error and (siteStatus.maintenance or siteStatus.ecommerceMaintenance or not siteStatus.brandActive) %}
              <a href="/admin/settings/general" class="alert alert-warning d-flex align-items-center gap-2 mb-0 py-3 px-4 text-decoration-none">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>
                  {% if not siteStatus.brandActive %}This brand is inactive.
                  {% elif siteStatus.maintenance %}The site is in maintenance mode.
                  {% else %}Ecommerce is in maintenance mode.{% endif %}
                </span>
              </a>
            {% endif %}
          </div>
        </div>

        {% if loadError %}
          <div class="alert alert-danger">The dashboard couldn't be loaded. Try refreshing the page.</div>
        {% elif not hasAnyWidget %}
          <div class="card dash-card">
            <div class="card-body text-center py-15">
              <i class="fa-solid fa-lock fs-2x text-muted mb-4"></i>
              <h3 class="fw-bold mb-2">No sections assigned yet</h3>
              <p class="text-muted mb-0">Your account doesn't have access to any CMS sections. Contact your administrator to get access.</p>
            </div>
          </div>
        {% else %}

          {# Stat cards #}
          <div class="row g-5 mb-6">
            {% if content and not content.error %}
              <div class="col-sm-6 col-xl">
                <div class="card dash-stat"><div class="card-body d-flex align-items-center gap-4">
                  <div class="dash-stat-icon bg-light-primary text-primary"><i class="fa-solid fa-file-lines"></i></div>
                  <div>
                    <div class="fs-2 fw-bold text-gray-900">{{ content.totals.published }}<span class="fs-6 text-muted fw-semibold"> / {{ content.totals.total }}</span></div>
                    <div class="text-muted fs-7">Published content</div>
                  </div>
                </div></div>
              </div>
              <div class="col-sm-6 col-xl">
                <div class="card dash-stat"><div class="card-body d-flex align-items-center gap-4">
                  <div class="dash-stat-icon bg-light-warning text-warning"><i class="fa-solid fa-pen-to-square"></i></div>
                  <div>
                    <div class="fs-2 fw-bold text-gray-900">{{ content.totals.unpublished }}</div>
                    <div class="text-muted fs-7">Unpublished{% if content.totals.scheduled %} · {{ content.totals.scheduled }} scheduled{% endif %}</div>
                  </div>
                </div></div>
              </div>
            {% endif %}
            {% if forms and not forms.error %}
              <div class="col-sm-6 col-xl">
                <div class="card dash-stat"><div class="card-body d-flex align-items-center gap-4">
                  <div class="dash-stat-icon bg-light-success text-success"><i class="fa-solid fa-inbox"></i></div>
                  <div>
                    {% if forms.canSeeSubmissions %}
                      <div class="fs-2 fw-bold text-gray-900">{{ forms.weekCount }}</div>
                      <div class="text-muted fs-7">Form submissions, last 7 days</div>
                    {% else %}
                      <div class="fs-2 fw-bold text-gray-900">{{ forms.formCount }}</div>
                      <div class="text-muted fs-7">Forms</div>
                    {% endif %}
                  </div>
                </div></div>
              </div>
            {% endif %}
            {% if media and not media.error %}
              <div class="col-sm-6 col-xl">
                <div class="card dash-stat"><div class="card-body d-flex align-items-center gap-4">
                  <div class="dash-stat-icon bg-light-info text-info"><i class="fa-solid fa-photo-film"></i></div>
                  <div>
                    <div class="fs-2 fw-bold text-gray-900">{{ media.total }}</div>
                    <div class="text-muted fs-7">Media files{% if media.totalSizeMb != '0.0' %} · {{ media.totalSizeMb }} MB{% endif %}</div>
                  </div>
                </div></div>
              </div>
            {% endif %}
            {% if accounts and not accounts.error %}
              <div class="col-sm-6 col-xl">
                <div class="card dash-stat"><div class="card-body d-flex align-items-center gap-4">
                  <div class="dash-stat-icon bg-light-danger text-danger"><i class="fa-solid fa-user-shield"></i></div>
                  <div>
                    <div class="fs-2 fw-bold text-gray-900">{{ accounts.activeAdmins }}</div>
                    <div class="text-muted fs-7">Active admins{% if accounts.inactiveAdmins %} · {{ accounts.inactiveAdmins }} inactive{% endif %}</div>
                  </div>
                </div></div>
              </div>
            {% endif %}
          </div>

          {# Quick actions #}
          {% if quickActions.length %}
            <div class="card dash-card mb-6">
              <div class="card-header border-0"><h3 class="card-title fw-bold">Quick actions</h3></div>
              <div class="card-body pt-0">
                <div class="row g-3">
                  {% for action in quickActions %}
                    <div class="col-sm-6 col-lg-4 col-xl-3">
                      <a href="{{ action.url }}" class="dash-quick"><i class="{{ action.icon }}"></i><span class="fw-semibold">{{ action.label }}</span></a>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

          <div class="row g-6">
            {# Content #}
            {% if content %}
              <div class="col-lg-6">
                <div class="card dash-card">
                  <div class="card-header border-0"><h3 class="card-title fw-bold">Recently updated content</h3></div>
                  <div class="card-body pt-0">
                    {% if content.error %}{{ widgetError() }}{% else %}{{ contentRows(content.recent, 'No content yet.', false) }}{% endif %}
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="card dash-card">
                  <div class="card-header border-0"><h3 class="card-title fw-bold">Content by type</h3></div>
                  <div class="card-body pt-0">
                    {% if content.error %}{{ widgetError() }}{% else %}
                      {% for t in content.byType %}
                        <div class="mb-4">
                          <div class="d-flex justify-content-between mb-1">
                            <a href="{{ t.url }}" class="text-gray-800 text-hover-primary fw-semibold">{{ t.title }}</a>
                            <span class="text-muted fw-semibold">{{ t.count }}</span>
                          </div>
                          <div class="dash-bar-track"><div class="dash-bar-fill" style="width: {{ (t.count / content.maxTypeCount * 100) | round }}%"></div></div>
                        </div>
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>
              </div>
              {% if not content.error %}
                <div class="col-lg-6">
                  <div class="card dash-card">
                    <div class="card-header border-0"><h3 class="card-title fw-bold">My recent edits</h3></div>
                    <div class="card-body pt-0">{{ contentRows(content.mine, "You haven't edited any content yet.", false) }}</div>
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="card dash-card">
                    <div class="card-header border-0"><h3 class="card-title fw-bold">Upcoming scheduled</h3></div>
                    <div class="card-body pt-0">{{ contentRows(content.scheduled, 'Nothing scheduled.', true) }}</div>
                  </div>
                </div>
              {% endif %}
            {% endif %}

            {# Form submissions #}
            {% if forms and forms.canSeeSubmissions %}
              <div class="col-lg-6">
                <div class="card dash-card">
                  <div class="card-header border-0">
                    <h3 class="card-title fw-bold">Form submissions</h3>
                    <div class="card-toolbar"><a href="/admin/custom-forms" class="btn btn-sm btn-light">All forms</a></div>
                  </div>
                  <div class="card-body pt-0">
                    <div class="d-flex gap-8 mb-5">
                      <div><div class="fs-3 fw-bold">{{ forms.todayCount }}</div><div class="text-muted fs-7">Today</div></div>
                      <div><div class="fs-3 fw-bold">{{ forms.weekCount }}</div><div class="text-muted fs-7">7 days</div></div>
                      <div><div class="fs-3 fw-bold">{{ forms.monthCount }}</div><div class="text-muted fs-7">30 days</div></div>
                    </div>
                    <div class="dash-trend mb-1" aria-label="Submissions per day, last 14 days">
                      {% for d in forms.trend %}
                        <div class="dash-trend-bar" style="height: {{ (d.count / forms.maxTrend * 100) | round }}%" title="{{ d.label }}: {{ d.count }}"></div>
                      {% endfor %}
                    </div>
                    <div class="d-flex justify-content-between text-muted fs-8 mb-4">
                      <span>{{ forms.trend[0].label }}</span><span>Today</span>
                    </div>
                    {% for s in forms.latest %}
                      <div class="dash-list-row">
                        {% if s.url %}<a href="{{ s.url }}" class="text-gray-800 text-hover-primary fw-semibold">{{ s.form }}</a>{% else %}<span class="text-muted">{{ s.form }}</span>{% endif %}
                        <span class="text-muted fs-7 text-nowrap">{{ s.createdAgo }}</span>
                      </div>
                    {% else %}
                      <div class="text-muted fs-7">No submissions yet.</div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% elif forms and forms.error %}
              <div class="col-lg-6"><div class="card dash-card"><div class="card-header border-0"><h3 class="card-title fw-bold">Form submissions</h3></div><div class="card-body pt-0">{{ widgetError() }}</div></div></div>
            {% endif %}

            {# Media #}
            {% if media %}
              <div class="col-lg-6">
                <div class="card dash-card">
                  <div class="card-header border-0">
                    <h3 class="card-title fw-bold">Recent uploads</h3>
                    <div class="card-toolbar"><a href="/admin/cms/media" class="btn btn-sm btn-light">Media library</a></div>
                  </div>
                  <div class="card-body pt-0">
                    {% if media.error %}{{ widgetError() }}{% else %}
                      <div class="row g-3 mb-4">
                        {% for m in media.recent %}
                          <div class="col-4 col-md-2 col-lg-4 col-xl-2"><img class="dash-thumb" src="{{ m.url }}" alt="{{ m.title }}" title="{{ m.title }}" loading="lazy"></div>
                        {% else %}
                          <div class="text-muted fs-7">No images uploaded yet.</div>
                        {% endfor %}
                      </div>
                      <div class="d-flex flex-wrap gap-2">
                        {% for t in media.byType %}<span class="badge badge-light">{{ t.type | upper }} · {{ t.count }}</span>{% endfor %}
                        {% if widgets.menus and not widgets.menus.error %}<a href="/admin/cms/menu" class="badge badge-light-primary">Menus · {{ widgets.menus.count }}</a>{% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}

            {# Activity (super_admin / admin only) #}
            {% if activity %}
              <div class="col-lg-6">
                <div class="card dash-card">
                  <div class="card-header border-0">
                    <h3 class="card-title fw-bold">Recent activity</h3>
                    <div class="card-toolbar"><a href="/admin/logs/audit" class="btn btn-sm btn-light">Audit logs</a></div>
                  </div>
                  <div class="card-body pt-0">
                    {% if activity.error %}{{ widgetError() }}{% else %}
                      {% if activity.failures24h %}
                        <div class="alert alert-light-danger py-2 px-3 fs-7 mb-3">{{ activity.failures24h }} failed action{% if activity.failures24h != 1 %}s{% endif %} in the last 24 hours</div>
                      {% endif %}
                      {% for a in activity.items %}
                        <div class="dash-list-row">
                          <a href="/admin/logs/audit/view/{{ a.id }}" class="text-gray-800 text-hover-primary min-w-0 text-truncate">
                            <span class="fw-semibold">{{ a.actor }}</span>
                            <span class="text-muted">{{ a.action }} {{ a.module }}</span>{% if a.label %} · {{ a.label }}{% endif %}
                          </a>
                          <span class="d-flex align-items-center gap-2 text-nowrap">
                            {% if a.failed %}<span class="badge badge-light-danger">Failed</span>{% endif %}
                            <span class="text-muted fs-7">{{ a.createdAgo }}</span>
                          </span>
                        </div>
                      {% else %}
                        <div class="text-muted fs-7 py-4">No activity recorded yet.</div>
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}

            {# Accounts (super_admin / admin only) #}
            {% if accounts %}
              <div class="col-lg-6">
                <div class="card dash-card">
                  <div class="card-header border-0"><h3 class="card-title fw-bold">Accounts</h3></div>
                  <div class="card-body pt-0">
                    {% if accounts.error %}{{ widgetError() }}{% else %}
                      <div class="d-flex gap-8 mb-5">
                        <div><div class="fs-3 fw-bold">{{ accounts.totalUsers }}</div><div class="text-muted fs-7">Site users</div></div>
                        <div><div class="fs-3 fw-bold">{{ accounts.newUsers }}</div><div class="text-muted fs-7">New this week</div></div>
                        <div><div class="fs-3 fw-bold">{{ accounts.activeAdmins }}</div><div class="text-muted fs-7">Active admins</div></div>
                      </div>
                      <div class="text-muted fw-semibold fs-7 text-uppercase mb-1">Recent admin logins</div>
                      {% for a in accounts.recentLogins %}
                        <div class="dash-list-row">
                          <span><span class="fw-semibold text-gray-800">{{ a.name }}</span> <span class="badge badge-light ms-1">{{ a.role | capitalize }}</span></span>
                          <span class="text-muted fs-7 text-nowrap">{{ a.lastLoginAgo }}</span>
                        </div>
                      {% else %}
                        <div class="text-muted fs-7 py-4">No logins recorded yet.</div>
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
