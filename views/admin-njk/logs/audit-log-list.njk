{% extends "../layouts/master.njk" %}

{% block csslib %}
    <link href="/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block content %}
    {% block title %}
		<title>Audit Logs | {{browserTitle | upper()}} CMS</title>
	{% endblock %}

    <div class="app-main flex-column flex-row-fluid" id="kt_app_main">
        <div class="d-flex flex-column flex-column-fluid">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar pt-2 pt-lg-10">
                <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
                    <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                        <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                            <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">Audit Logs</h1>
                            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                                <li class="breadcrumb-item text-muted">
                                    <a href="/admin/dashboard" class="text-muted text-hover-primary">Home</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span class="bullet bg-gray-500 w-5px h-2px"></span>
                                </li>
                                <li class="breadcrumb-item text-muted">Audit Logs</li>
                            </ul>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a href="#" id="audit_export_btn" class="btn btn-sm btn-light-primary">Export CSV</a>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Toolbar-->
            <div id="kt_app_content" class="app-content flex-column-fluid">
                <div id="kt_app_content_container" class="app-container container-fluid">
                    <div class="card card-flush">
                        <!--begin::Filters-->
                        <div class="card-body pt-6 pb-2 border-bottom">
                            <form id="audit_filter_form">
                                <div class="row g-3 align-items-end">
                                    <div class="col-12 col-md-6 col-xl-4">
                                        <label class="form-label fs-7">Search</label>
                                        <input type="text" name="q" value="{{ filters.q }}" class="form-control form-control-sm form-control-solid" placeholder="Email, record, URL, IP…"/>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3 col-xl-4">
                                        <label class="form-label fs-7">Admin</label>
                                        <select name="admin" class="form-select form-select-sm form-select-solid">
                                            <option value="">All</option>
                                            {% for a in admins %}
                                                <option value="{{ a._id }}" {% if filters.admin == a._id | string %}selected{% endif %}>{{ a.name }} ({{ a.email }}){% if a.deleted %} – deleted{% endif %}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3 col-xl-4">
                                        <label class="form-label fs-7">Module</label>
                                        <select name="module" class="form-select form-select-sm form-select-solid">
                                            <option value="">All</option>
                                            {% for m in modules %}
                                                <option value="{{ m }}" {% if filters.module == m %}selected{% endif %}>{{ m }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                                        <label class="form-label fs-7">Action</label>
                                        <select name="action" class="form-select form-select-sm form-select-solid">
                                            <option value="">All</option>
                                            {% for a in actions %}
                                                <option value="{{ a }}" {% if filters.action == a %}selected{% endif %}>{{ a }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                                        <label class="form-label fs-7">Status</label>
                                        <select name="status" class="form-select form-select-sm form-select-solid">
                                            <option value="">All</option>
                                            <option value="success" {% if filters.status == 'success' %}selected{% endif %}>Success</option>
                                            <option value="failure" {% if filters.status == 'failure' %}selected{% endif %}>Failure</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3 col-xl-3">
                                        <label class="form-label fs-7">From</label>
                                        <input type="date" name="from" value="{{ filters.from }}" class="form-control form-control-sm form-control-solid"/>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3 col-xl-3">
                                        <label class="form-label fs-7">To</label>
                                        <input type="date" name="to" value="{{ filters.to }}" class="form-control form-control-sm form-control-solid"/>
                                    </div>
                                    <div class="col-12 col-xl-2 d-flex gap-2">
                                        <button type="submit" class="btn btn-sm btn-primary flex-fill">Filter</button>
                                        <a href="/admin/logs/audit" class="btn btn-sm btn-light flex-fill">Reset</a>
                                    </div>
                                </div>
                                <input type="hidden" name="entity_id" value="{{ filters.entity_id }}"/>
                                <input type="hidden" name="entity_type" value="{{ filters.entity_type }}"/>
                                <input type="hidden" name="ip" value="{{ filters.ip }}"/>
                            </form>
                        </div>
                        <!--end::Filters-->
                        <div class="card-body pt-0">
                            <div class="table-responsive">
                            <table class="table align-middle table-row-dashed fs-7 gy-4" id="audit_logs_datatable">
                                <thead>
                                    <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                                        <th class="min-w-125px">Date</th>
                                        <th class="min-w-150px">Admin</th>
                                        <th class="min-w-100px">Module</th>
                                        <th class="min-w-75px">Action</th>
                                        <th class="min-w-200px">Record</th>
                                        <th class="min-w-100px">IP</th>
                                        <th class="min-w-75px">Brand</th>
                                        <th class="min-w-50px text-end"></th>
                                    </tr>
                                </thead>
                                <tbody class="fw-semibold text-gray-600"></tbody>
                            </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block customScript %}
    <script src="/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="/cms-static/admin/custom/audit-log-list.js"></script>
{% endblock %}
