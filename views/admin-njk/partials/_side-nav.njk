{% from './_brand-logo.njk' import brandLogo %}
{# Highlight the current page in the sidebar. The theme's active styles are scoped to
   .app-sidebar, which #main-nav doesn't use. Kept here, not in style.bundle.css,
   because /public/admin/assets/ is not tracked in git. #}
<style>
    #main-nav .menu-item .menu-link.active {
        background-color: rgba(255, 255, 255, 0.14);
        box-shadow: inset 3px 0 0 #fff;
        transition: background-color 0.2s ease;
    }
    #main-nav .menu-item .menu-link.active .menu-title { font-weight: 600; color: #fff; }
    #main-nav .menu-item .menu-link.active .menu-icon .svg-icon,
    #main-nav .menu-item .menu-link.active .menu-icon i { color: #fff; }
    #main-nav .menu-item .menu-link.active .menu-bullet .bullet { background-color: #fff; }
</style>
<div class="app-sidebar-logo px-6">
    <a href="{{LANDING_URL}}" class="m-auto text-center text-decoration-none mw-100">
        <span class="app-sidebar-logo-default">
            {{ brandLogo(cmsLogoLarge, browserTitle, 'h-50px', 'text-white fw-bold fs-3 text-truncate d-inline-block mw-100 align-middle') }}
        </span>
        <span class="app-sidebar-logo-minimize">
            {{ brandLogo(cmsLogoSmall, clientInitials or browserTitle, 'h-20px', 'text-white fw-bold fs-5') }}
        </span>
    </a>
</div>
<hr/>
<div class="overflow-y-auto flex-1" id="beaver_sidebar_scroll">
    <div class="menu menu-column menu-rounded menu-sub-indention px-3" id="#beaver_app_sidebar_menu" data-beaver-menu="true" data-beaver-menu-expand="false">
        {% if authUser.admin_role == 'super_admin' %}
            <div class="menu-item pt-5">
                <div class="menu-content">
                    <span class="menu-heading fw-bold text-uppercase fs-7">Configurations</span>
                </div>
            </div>
            <div class="menu-item menu-accordion {{ 'here show' if activeNav.includes(`/admin/config/`)}}" data-beaver-menu-trigger="click">
                <span class="menu-link">
                    <span class="menu-icon">
                        <span class="svg-icon svg-icon-2">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path opacity="0.3" d="M22.0318 8.59998C22.0318 10.4 21.4318 12.2 20.0318 13.5C18.4318 15.1 16.3318 15.7 14.2318 15.4C13.3318 15.3 12.3318 15.6 11.7318 16.3L6.93177 21.1C5.73177 22.3 3.83179 22.2 2.73179 21C1.63179 19.8 1.83177 18 2.93177 16.9L7.53178 12.3C8.23178 11.6 8.53177 10.7 8.43177 9.80005C8.13177 7.80005 8.73176 5.6 10.3318 4C11.7318 2.6 13.5318 2 15.2318 2C16.1318 2 16.6318 3.20005 15.9318 3.80005L13.0318 6.70007C12.5318 7.20007 12.4318 7.9 12.7318 8.5C13.3318 9.7 14.2318 10.6001 15.4318 11.2001C16.0318 11.5001 16.7318 11.3 17.2318 10.9L20.1318 8C20.8318 7.2 22.0318 7.59998 22.0318 8.59998Z" fill="currentColor"></path>
                                <path d="M4.23179 19.7C3.83179 19.3 3.83179 18.7 4.23179 18.3L9.73179 12.8C10.1318 12.4 10.7318 12.4 11.1318 12.8C11.5318 13.2 11.5318 13.8 11.1318 14.2L5.63179 19.7C5.23179 20.1 4.53179 20.1 4.23179 19.7Z" fill="currentColor"></path>
                            </svg>
                        </span>
                    </span>
                    <span class="menu-title">Configurations</span>
                    <span class="menu-arrow"></span>
                </span>
                <div class="menu-sub menu-sub-accordion">
                    <div class="menu-item">
                        <a class="menu-link {{ 'active' if activeNav.includes('/admin/config/admin') }}" href="/admin/config/admin">
                            <span class="menu-bullet">
                                <span class="bullet bullet-dot"></span>
                            </span>
                            <span class="menu-title">Admin</span>
                        </a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link {{ 'active' if activeNav.includes('/admin/config/country') }}" href="/admin/config/country">
                            <span class="menu-bullet">
                                <span class="bullet bullet-dot"></span>
                            </span>
                            <span class="menu-title">Country</span>
                        </a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link {{ 'active' if activeNav.includes('/admin/config/language') }}" href="/admin/config/language">
                            <span class="menu-bullet">
                                <span class="bullet bullet-dot"></span>
                            </span>
                            <span class="menu-title">Languages</span>
                        </a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link {{ 'active' if activeNav.includes('/admin/config/brand') }}" href="/admin/config/brand">
                            <span class="menu-bullet">
                                <span class="bullet bullet-dot"></span>
                            </span>
                            <span class="menu-title">Brands</span>
                        </a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link {{ 'active' if activeNav.includes('/admin/config/content-type') }}" href="/admin/config/content-type">
                            <span class="menu-bullet">
                                <span class="bullet bullet-dot"></span>
                            </span>
                            <span class="menu-title">Content Type</span>
                        </a>
                    </div>
                    {# Commented beacuase this feature is rarely used #}
                    <div class="menu-item">
                        <a class="menu-link {{ 'active' if activeNav.includes('/admin/config/admin-nav') }}" href="/admin/config/admin-nav">
                            <span class="menu-bullet">
                                <span class="bullet bullet-dot"></span>
                            </span>
                            <span class="menu-title">Admin Nav</span>
                        </a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link {{ 'active' if activeNav.includes('/admin/config/app-settings') }}" href="/admin/config/app-settings">
                            <span class="menu-bullet">
                                <span class="bullet bullet-dot"></span>
                            </span>
                            <span class="menu-title">App Settings</span>
                        </a>
                    </div>
                </div>
            </div>
            <hr>
        {% endif %}
        {% if authUser.admin_role == 'admin' %}
            <div class="menu-item pt-5">
                <div class="menu-content">
                    <span class="menu-heading fw-bold text-uppercase fs-7">Access Control</span>
                </div>
            </div>
            <div class="menu-item">
                <a class="menu-link {{ 'active' if activeNav == '/admin/access-control/users' }}" href="/admin/access-control/users">
                    <span class="menu-icon">
                        <span class="svg-icon svg-icon-2">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path opacity="0.3" d="M20.5543 4.37824L12.1798 2.02473C12.0626 1.99176 11.9376 1.99176 11.8203 2.02473L3.44572 4.37824C3.18118 4.45258 3 4.6807 3 4.93945V13.569C3 14.6914 3.48509 15.8404 4.4417 16.984C5.17231 17.8575 6.18314 18.7345 7.446 19.5909C9.56752 21.0295 11.6566 21.912 11.7445 21.9488C11.8258 21.9829 11.9129 22 12.0001 22C12.0872 22 12.1744 21.983 12.2557 21.9488C12.3435 21.912 14.4326 21.0295 16.5541 19.5909C17.8169 18.7345 18.8277 17.8575 19.5584 16.984C20.515 15.8404 21 14.6914 21 13.569V4.93945C21 4.6807 20.8189 4.45258 20.5543 4.37824Z" fill="currentColor"></path>
                                <path d="M12.0006 11.1542C13.1434 11.1542 14.0777 10.22 14.0777 9.0771C14.0777 7.93424 13.1434 7 12.0006 7C10.8577 7 9.92348 7.93424 9.92348 9.0771C9.92348 10.22 10.8577 11.1542 12.0006 11.1542Z" fill="currentColor"></path>
                                <path d="M15.5652 13.814C15.5108 13.6779 15.4382 13.551 15.3566 13.4331C14.9393 12.8163 14.2954 12.4081 13.5697 12.3083C13.479 12.2993 13.3793 12.3174 13.3067 12.3718C12.9257 12.653 12.4722 12.7981 12.0006 12.7981C11.5289 12.7981 11.0754 12.653 10.6944 12.3718C10.6219 12.3174 10.5221 12.2902 10.4314 12.3083C9.70578 12.4081 9.05272 12.8163 8.64456 13.4331C8.56293 13.551 8.49036 13.687 8.43595 13.814C8.40875 13.8684 8.41781 13.9319 8.44502 13.9864C8.51759 14.1133 8.60828 14.2403 8.68991 14.3492C8.81689 14.5215 8.95295 14.6757 9.10715 14.8208C9.23413 14.9478 9.37925 15.0657 9.52439 15.1836C10.2409 15.7188 11.1026 15.9999 11.9915 15.9999C12.8804 15.9999 13.7421 15.7188 14.4586 15.1836C14.6038 15.0748 14.7489 14.9478 14.8759 14.8208C15.021 14.6757 15.1661 14.5215 15.2931 14.3492C15.3838 14.2312 15.4655 14.1133 15.538 13.9864C15.5833 13.9319 15.5924 13.8684 15.5652 13.814Z" fill="currentColor"></path>
                            </svg>
                        </span>
                    </span>
                    <span class="menu-title">User Management</span>
                </a>
            </div>
            <hr>
        {% endif %}
        {% for navSection in mainNav %}
            {% if checkSectionAllowed(allowedSections,navSection.section_slug,authUser) %}
                <div class="menu-item pt-5">
                    <div class="menu-content">
                        <span class="menu-heading fw-bold text-uppercase fs-7">{{navSection.section}}</span>
                    </div>
                </div>
                {% for navItem in navSection.items %}
                    {% if navItem.expandable and checkAnyChildPathAllowed(allowedURLs, navItem.child,authUser) %}
                        <div class="menu-item menu-accordion {{ 'here show' if activeNav.includes(navItem.path) }}" data-beaver-menu-trigger="click">
                            <span class="menu-link">
                                <span class="menu-icon">
                                    <span class="svg-icon svg-icon-2">{{navItem.icon|safe}}</span>
                                </span>
                                <span class="menu-title">{{navItem.label}}</span>
                                <span class="menu-arrow"></span>
                            </span>
                            <div class="menu-sub menu-sub-accordion">
                                {% for child in navItem.child %}
                                    {% if checkPathAllowed(allowedURLs,child.path,authUser) %}
                                        <div class="menu-item">
                                            <a class="menu-link {{ 'active' if activeNav == child.path }}" href="{{child.path}}">
                                                <span class="menu-bullet">
                                                    <span class="bullet bullet-dot"></span>
                                                </span>
                                                <span class="menu-title">{{child.label}}</span>
                                            </a>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    {% elif checkPathAllowed(allowedURLs,navItem.path,authUser) %}
                        <div class="menu-item">
                            <a class="menu-link {{ 'active' if activeNav.includes(navItem.path) }}" href="{{navItem.path}}">
                                <span class="menu-icon">
                                    <span class="svg-icon svg-icon-2">{{navItem.icon|safe}}</span>
                                </span>
                                <span class="menu-title">{{navItem.label}}</span>
                            </a>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}
    </div>
</div>